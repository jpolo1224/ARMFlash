 #ifdef ANDROID
-static int shm_open(const char *name, int oflag, mode_t mode) {
+static int box_shm_open(const char *name, int oflag, mode_t mode) {
     return -1;
 }
-static int shm_unlink(const char *name) {
+static int box_shm_unlink(const char *name) {
     return -1;
 }
+#elif defined(FLASHARM_NO_HOST_EXEC)
+// ARMFlash: the base system's glibc was built with Winlator's shared memory folder
+// (/data/data/com.winlator/files/rootfs/tmp/shm/, 45 characters) and copies exactly that many
+// bytes into every path. Relocated to ARMFlash's shorter folder (NUL padded), each path ended at
+// the folder itself, which open() refuses (EISDIR, reported as EINVAL): Wine's esync could never
+// start, and Box64's own fake /proc files failed too. Paths are built here instead, in
+// $TMPDIR/shm/ (ARMFlash's r/tmp/shm), with glibc's name rules and error codes.
+static int armflash_shm_path(char* out, size_t outlen, const char* name)
+{
+    while(*name == '/')
+        ++name;
+    size_t n = strlen(name);
+    if(!n || memchr(name, '/', n)) {
+        errno = EINVAL;
+        return -1;
+    }
+    const char* tmp = getenv("TMPDIR");
+    int len = snprintf(out, outlen, "%s/shm/%s", (tmp && *tmp) ? tmp : "/dev", name);
+    if(len < 0 || (size_t)len >= outlen) {
+        errno = ENAMETOOLONG;
+        return -1;
+    }
+    return 0;
+}
+static int box_shm_open(const char *name, int oflag, mode_t mode) {
+    char path[4096];
+    if(armflash_shm_path(path, sizeof(path), name))
+        return -1;
+    int fd = open(path, oflag | O_NOFOLLOW | O_CLOEXEC, mode);
+    if(fd < 0 && errno == EISDIR)
+        errno = EINVAL;
+    return fd;
+}
+static int box_shm_unlink(const char *name) {
+    char path[4096];
+    if(armflash_shm_path(path, sizeof(path), name))
+        return -1;
+    int ret = unlink(path);
+    if(ret < 0 && errno == EPERM)
+        errno = EACCES;
+    return ret;
+}
+#else
+#define box_shm_open shm_open
+#define box_shm_unlink shm_unlink
 #endif
+EXPORT int my_shm_open(x64emu_t* emu, const char* name, int oflag, int mode)
+{
+    (void)emu;
+    return box_shm_open(name, of_convert(oflag), (mode_t)mode);
+}
+EXPORT int my_shm_unlink(x64emu_t* emu, const char* name)
+{
+    (void)emu;
+    return box_shm_unlink(name);
+}
 
