@@ -47,6 +47,38 @@
 
 #include "signal_private.h"
 
+#if defined(__aarch64__) && defined(FLASHARM_NO_HOST_EXEC)
+// ARMFlash: whether the kernel says the faulting access was a write (ESR_EL1.WnR, kept in the
+// signal frame's esr_context record). write_opcode only guesses from the x86 bytes, and its
+// decoders for SSE opcodes with a 66, F2 or F3 prefix are empty, so a movdqa/movdqu/movsd/movss
+// store (or a native libc call writing for the guest) into a page Wine keeps read-only on purpose
+// (write watch, copy on write) reached Wine as a read fault, which Wine turns into an access
+// violation: Silverlight's .NET runtime died in its SSE2 memcpy on a write-watched GC page.
+// Trusted only when the frame's fault address is this signal's.
+static int armflash_fault_is_write(void* ucntx, void* fault_addr)
+{
+    if(!ucntx)
+        return 0;
+    ucontext_t* uc = (ucontext_t*)ucntx;
+    if((void*)uc->uc_mcontext.fault_address != fault_addr)
+        return 0;
+    uintptr_t p = (uintptr_t)uc->uc_mcontext.__reserved;
+    uintptr_t end = p + sizeof(uc->uc_mcontext.__reserved);
+    while(p + sizeof(struct _aarch64_ctx) <= end) {
+        struct _aarch64_ctx* ctx = (struct _aarch64_ctx*)p;
+        if(!ctx->magic || ctx->size < sizeof(struct _aarch64_ctx) || p + ctx->size > end)
+            break;
+        if(ctx->magic == 0x45535201 /* ESR_MAGIC */ && ctx->size >= 16) {
+            uint64_t esr = ((uint64_t*)p)[1];
+            uint32_t ec = (esr >> 26) & 0x3f;
+            return (ec == 0x24 || ec == 0x25) && ((esr >> 6) & 1);  // data abort, WnR set
+        }
+        p += ctx->size;
+    }
+    return 0;
+}
+#endif
