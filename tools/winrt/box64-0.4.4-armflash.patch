diff --git a/src/wrapped/wrappedlibc.c b/src/wrapped/wrappedlibc.c
index c995a0c..e778ccd 100644
--- a/src/wrapped/wrappedlibc.c
+++ b/src/wrapped/wrappedlibc.c
@@ -3597,11 +3597,20 @@ static int is_elf_or_pe(int fd)
     return !memcmp(magic, "PE\0\0", sizeof(magic));
 }
 
+// FlashARM: Android (apps targeting API 29+) refuses PROT_EXEC on mappings of files the app
+// wrote, which is where Wine's PE images live. Guest x86 pages are never executed by the host
+// (the dynarec translates them into its own memory), so the host mapping does not need
+// PROT_EXEC; Box64 still records the guest protection, which is what it acts on.
+#ifdef FLASHARM_NO_HOST_EXEC
+#define HOST_PROT(p) ((p) & ~PROT_EXEC)
+#else
+#define HOST_PROT(p) (p)
+#endif
 EXPORT void* my_mmap64(x64emu_t* emu, void *addr, size_t length, int prot, int flags, int fd, ssize_t offset)
 {
     (void)emu;
     if(BOX64ENV(dynarec_log)>=LOG_DEBUG) {printf_log(LOG_NONE, "mmap64(%p, 0x%zx, 0x%x, 0x%x, %d, %zd) ", addr, length, prot, flags, fd, offset);}
-    void* ret = box_mmap(addr, length, prot, flags, fd, offset);
+    void* ret = box_mmap(addr, length, HOST_PROT(prot), flags, fd, offset);
     int e = errno;
     if(emu && box64_is32bits && ret!=MAP_FAILED && ((ret>(void*)0xc0000000) || (ret+length>(void*)0xc0000000))) {
         // do not allow allocating memory that high for 32bits process
@@ -3772,7 +3781,7 @@ EXPORT int my_mprotect(x64emu_t* emu, void *addr, unsigned long len, int prot)
     if(emu && (BOX64ENV(log)>=LOG_DEBUG || BOX64ENV(dynarec_log)>=LOG_DEBUG)) {printf_log(LOG_NONE, "mprotect(%p, 0x%lx, 0x%x)\n", addr, len, prot);}
     if(prot&PROT_WRITE)
         prot|=PROT_READ;    // PROT_READ is implicit with PROT_WRITE on x86_64
-    int ret = mprotect(addr, len, prot);
+    int ret = mprotect(addr, len, HOST_PROT(prot));
     if(!ret && len) {
         updateProtection((uintptr_t)addr, len, prot);
     }
