<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Touch Haptics: a short tick on an on-screen key press. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The Discord Social SDK's voice permissions: ARMFlash uses no voice or microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />

    <application
        android:name=".FpApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@style/Theme.Fp">

        <activity
            android:name=".BootActivity"
            android:exported="true"
            android:theme="@style/Theme.Fp.Boot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
        </activity>

        <!-- Games from outside, passed on at once (see LinkActivity). No task of its own, so a
             frontend's repeated link is never swallowed by Android. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!-- Frontends and home-screen shortcuts: armflash://play/<Flashpoint game id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="armflash" android:host="play" />
            </intent-filter>
            <!-- A game's .armflash file, opened by ES-DE, Daijisho, Beacon or a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.Fp.Game" />

        <!-- Recently played games for companion apps, opt-in per app (ARMSX2's provider). -->
        <provider
            android:name=".data.recent.RecentGamesContentProvider"
            android:authorities="${applicationId}.romlibrary"
            android:exported="true" />
        <activity
            android:name=".data.recent.RecentGamesAccessActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.REQUEST_RECENT_GAMES_ACCESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Windows plugin games (Shockwave, Unity and others) under Wine on a virtual screen. -->
        <activity
            android:name=".win.WinActivity"
            android:exported="false"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@style/Theme.Fp.Game" />

        <!-- Native Flash (Ruffle). GameActivity loads libfpruffle.so and runs its android_main. -->
        <activity
            android:name=".game.RuffleActivity"
            android:exported="false"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.Fp.Ruffle">
            <meta-data android:name="android.app.lib_name" android:value="fpruffle" />
        </activity>

        <!-- Discord Rich Presence (as in ARMSX2). The SDK runs only in :discord. -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:process=":discord"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${discordScheme}" />
            </intent-filter>
        </activity>
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
        <service
            android:name=".discord.DiscordService"
            android:process=":discord"
            android:exported="false" />
        <activity
            android:name=".discord.DiscordAuthActivity"
            android:process=":discord"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- Discord sign-in and switches asked for from a game's quick menu, run in the launcher's
             process, which keeps the sign-in. -->
        <receiver android:name=".discord.DiscordControlReceiver" android:exported="false" />
    </application>
</manifest>
